<UserControl
    x:Class="EestiQuizer.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:EestiQuizer.Views"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    Background="White"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <MenuItem
                Header="Save"
                Click="SaveSettings_Click"
            />
        </Menu>

        <Label 
            Grid.Row="1" Grid.Column="0"
            Content="EkilexApiKey"
        />
        <TextBox 
            Grid.Row="1" Grid.Column="1"
            Text="{Binding
                Path=Settings.EkilexApiKey,
                UpdateSourceTrigger=PropertyChanged
            }"
        />

        <Label 
            Grid.Row="2" Grid.Column="0"
            Content="AnkiProfileName"
        />
        <TextBox 
            Grid.Row="2" Grid.Column="1"
            Text="{Binding
                Path=Settings.AnkiProfileName,
                UpdateSourceTrigger=PropertyChanged
            }"
        />

        <Label 
            Grid.Row="3" Grid.Column="0"
            Content="OutputFolderPath"
        />
        <TextBox 
            Grid.Row="3" Grid.Column="1"
            Text="{Binding
                Path=Settings.OutputFolderPath,
                UpdateSourceTrigger=PropertyChanged
            }"
        />

        <Label 
            Grid.Row="4" Grid.Column="0"
            Content="ImageCachePath"
        />
        <TextBox 
            Grid.Row="4" Grid.Column="1"
            IsReadOnly="True"
            Text="{Binding Path=Settings.ImageCachePath, Mode=OneWay}"
        />

        <Label 
            Grid.Row="5" Grid.Column="0"
            Content="TagForDBChecking"
        />
        <TextBox 
            Grid.Row="5" Grid.Column="1"
            Text="{Binding 
                Path=Settings.TagForDBChecking,
                UpdateSourceTrigger=PropertyChanged
            }"
        />

        <Label 
            Grid.Row="6" Grid.Column="0"
            Content="SentenceLengthOrigin"
        />
        <TextBox 
            Grid.Row="6" Grid.Column="1"
            Text="{Binding
                Path=Settings.SentenceLengthOrigin,
                UpdateSourceTrigger=PropertyChanged
            }"
        />

        <Label 
            Grid.Row="7" Grid.Column="0"
            Content="UsageSentencesToTake"
        />
        <TextBox 
            Grid.Row="7" Grid.Column="1"
            Text="{Binding
                Path=Settings.UsageSentencesToTake,
                UpdateSourceTrigger=PropertyChanged
            }"
        />

    </Grid>
</UserControl>
