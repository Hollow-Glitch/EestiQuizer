<UserControl
    x:Class="EestiQuizer.Views.EkilexView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:EestiQuizer.Views"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    Background="White"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    >
    <Grid>          
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem
                Header="Clear"
                Click="ClearOutput_Click"
            />
            <MenuItem
                Header="Load word"
                Click="TextBoxToEkilex_Click"
            />
            <MenuItem
                Header="Load files"
                Click="LoadFilesFromFolder_Click"
            />
        </Menu>

        <TextBox 
            Grid.Row="1"
            Name="InputBox"
        />

        <DataGrid Grid.Row="2" 
            AutoGenerateColumns="False"
            ItemsSource="{Binding EkilexCardDataCollection}" >
            <DataGrid.Columns>
                <DataGridTextColumn
                    Header="level"
                    Binding="{Binding ProficiencyLevel}"
                    Width="Auto"
                />
                <DataGridTextColumn
                    Header="Form1"
                    Binding="{Binding Form1}"
                    Width="100"
                />
                <DataGridTextColumn
                    Header="Form2"
                    Binding="{Binding Form2}"
                    Width="100"
                />
                <DataGridTextColumn
                    Header="Form3"
                    Binding="{Binding Form3}"
                    Width="100"
                />
                <DataGridTextColumn
                    Header="WordClass"
                    Binding="{Binding WordClass}"
                    Width="100"
                />
                <DataGridTextColumn
                    Header="PartOfSpeech"
                    Binding="{Binding PartOfSpeech}"
                    Width="100"
                />
                <DataGridTextColumn
                    Header="Translations"
                    Binding="{Binding Translations}"
                    Width="300"
                />
                <DataGridTextColumn
                    Header="Tags"
                    Binding="{Binding Tags}"
                    Width="300"
                />
                <DataGridTextColumn
                    Header="Examples"
                    Binding="{Binding Examples}"
                    Width="1000"
                />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter
            Grid.Row="3" Height="5"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Center" 
            ResizeDirection="Rows"
        />

        <TextBox
            Grid.Row="4" 
            Name="OutputBox"
            IsReadOnly="True"
            HorizontalScrollBarVisibility="Visible"
            VerticalScrollBarVisibility="Visible"
            FontFamily="Courier New"
        />
    </Grid>
</UserControl>
