<UserControl
    x:Class="EestiQuizer.Views.EkilexView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EestiQuizer.Views"
    xmlns:common="clr-namespace:EestiQuizer.Common"
    xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800"
    Background="White"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    >

    <UserControl.Resources>
        <common:EnumerableToStringValueConverter 
            x:Key="EnumerableToStringConverter" 
        />
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem
                Header="Clear"
                Click="ClearOutput_Click"
            />
            <MenuItem
                Header="Load word"
                Click="LoadWord_Click"
            />
            <MenuItem
                Header="Load files"
                Click="LoadFilesFromFolder_Click"
            />
        </Menu>

        <TextBox
            Grid.Row="1"
            Name="InputBox"
        />

        <DataGrid
            SelectionChanged="CardDataGrid_SelectionChanged"
            x:Name="CardDataGrid"
            Grid.Row="2"
            AutoGenerateColumns="False"
            ItemsSource="{Binding Path=EkilexCardDataCollection}"
            >
            <DataGrid.Columns>
                <DataGridTextColumn 
                    Header="level"
                    Binding="{Binding Path=ProficiencyLevel}"
                    Width="Auto"
                />
                <DataGridTextColumn 
                    Header="Id"
                    Binding="{Binding Path=Id}"
                    Width="100"
                />
                <DataGridTextColumn 
                    Header="Form1"
                    Binding="{Binding Path=Form1}"
                    Width="100"
                />
                <DataGridTextColumn 
                    Header="Form2"
                    Binding="{Binding Path=Form2}"
                    Width="100"
                />
                <DataGridTextColumn 
                    Header="Form3"
                    Binding="{Binding Path=Form3}"
                    Width="100"
                />
                <DataGridTextColumn 
                    Header="Form4"
                    Binding="{Binding Path=Form4}"
                    Width="100"
                />
                <DataGridTextColumn 
                    Header="Form5"
                    Binding="{Binding Path=Form5}"
                    Width="100"
                />
                <DataGridTextColumn 
                    Header="Form6"
                    Binding="{Binding Path=Form6}"
                    Width="100"
                />
                <DataGridTextColumn
                    Header="WordClass"
                    Binding="{Binding Path=WordClass}"
                    Width="100" 
                />
                <DataGridTextColumn
                    Header="PartOfSpeech"
                    Binding="{Binding Path=PartOfSpeech}"
                    Width="100"
                />
                <DataGridTextColumn
                    Header="Translations"
                    Binding="{Binding Path=Translations}"
                    Width="300"
                />
                <DataGridTextColumn
                    Header="Tags"
                    Binding="{Binding Path=Tags}"
                    Width="300"
                />
                <DataGridTextColumn
                    Header="Examples"
                    Binding="{Binding Path=Examples}"
                    Width="1000"
                />
                <DataGridTextColumn 
                    Header="image urls" 
                    Binding="{Binding 
                        Path=ImageNamesInCache,
                        Converter={StaticResource EnumerableToStringConverter}
                    }" 
                    Width="1000" 
                />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter
            Grid.Row="3" Height="5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            ResizeDirection="Rows"
        />

        <Grid Grid.Row="4" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- This listbox is this complicated because AI suggested
                 to ensure the virtualization with these incantations.-->
            <ListBox
                Name="LogView"
                Grid.Column="0"
                ItemsSource="{Binding Path=Logs}"
                FontFamily="Courier New"
                VirtualizingStackPanel.IsVirtualizing="True"
                VirtualizingStackPanel.VirtualizationMode="Recycling"
                ScrollViewer.CanContentScroll="True"
                HorizontalContentAlignment="Left"
            >
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <Wpf:WebView2 
                x:Name="ImageWebView"
                Grid.Column="1"
                Source="about:blank"
            />
        </Grid>
    </Grid>
</UserControl>
