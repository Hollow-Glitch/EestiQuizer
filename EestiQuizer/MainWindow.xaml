<Window x:Class="EestiQuizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EestiQuizer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem
                Name="GetFromSonapiMenuItem"
                Header="Get from sonapi"
                Click="GetFromSonapi_Click"
            />
            <MenuItem
                Name="ConvertToAnkiFormatMenuItem"
                Header="To anki format"
                Click="ConvertToAnkiFormat_Click"
            />
        </Menu>

        <TextBox 
            Grid.Row="1"
            Name="InputBox"
        />

        <TextBox
            Grid.Row="2" 
            Name="OutputBox"
            IsReadOnly="True"
            HorizontalScrollBarVisibility="Visible"
            VerticalScrollBarVisibility="Visible"
            FontFamily="Courier New"
        />
    </Grid>
</Window>
